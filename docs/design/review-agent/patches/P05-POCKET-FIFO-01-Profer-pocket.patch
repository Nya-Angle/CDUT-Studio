+describe('P05-POCKET-FIFO-01 unmatched command_result safety', () => {
+  type Pending = { resolve: (result: unknown) => void; reject: (error: Error) => void }
+  function fixture() {
+    const delivered: string[] = []
+    const settled: string[] = []
+    const rejected: string[] = []
+    const client = new WsClient({
+      url: 'ws://127.0.0.1/ws', token: 'local-only',
+      onCommandResult: result => delivered.push(result.commandId),
+    })
+    const probe = client as unknown as {
+      pendingCommands: Map<string, Pending>
+      handleMessage: (value: unknown) => void
+    }
+    const add = (id: string) => probe.pendingCommands.set(id, {
+      resolve: value => settled.push(id + ':' + String(value)),
+      reject: error => rejected.push(id + ':' + error.message),
+    })
+    const recv = (value: Record<string, unknown>) => probe.handleMessage({ kind: 'command_result', ...value })
+    return { probe, delivered, settled, rejected, add, recv }
+  }
+
+  test('nonmatching commandId and business requestId do not settle or notify Remote Store', () => {
+    const f = fixture()
+    f.add('a-command')
+    f.add('b-command')
+    f.recv({ commandId: 'foreign-viewer-command', requestId: 'a-command', ok: true, data: 'leak' })
+    f.recv({ commandId: 'old-reconnect-command', requestId: null, ok: true, data: 'stale' })
+    expect(f.settled).toEqual([])
+    expect(f.delivered).toEqual([])
+    expect(f.probe.pendingCommands.size).toBe(2)
+    f.recv({ commandId: 'b-command', requestId: 'business-shared', ok: true, data: 'right-b' })
+    f.recv({ commandId: 'a-command', requestId: 'business-shared', ok: true, data: 'right-a' })
+    expect(f.settled).toEqual(['b-command:right-b', 'a-command:right-a'])
+    expect(f.delivered).toEqual(['b-command', 'a-command'])
+    f.recv({ commandId: 'a-command', requestId: null, ok: true, data: 'duplicate' })
+    expect(f.delivered).toEqual(['b-command', 'a-command'])
+  })
+
+  test('ID-less legacy response is only allowed with one pending and normalizes store commandId', () => {
+    const f = fixture()
+    f.add('first')
+    f.add('second')
+    f.recv({ commandId: '', requestId: null, ok: true, data: 'ambiguous' })
+    expect(f.settled).toEqual([])
+    expect(f.delivered).toEqual([])
+    f.recv({ commandId: 'first', requestId: null, ok: true, data: 'first-value' })
+    f.recv({ commandId: '', requestId: null, ok: true, data: 'last-value' })
+    expect(f.settled).toEqual(['first:first-value', 'second:last-value'])
+    expect(f.delivered).toEqual(['first', 'second'])
+  })
+
+  test('matched error affects only its pending command; unsolicited errors do nothing', () => {
+    const f = fixture()
+    f.add('correct')
+    f.add('other')
+    f.recv({ commandId: 'foreign-error', requestId: null, ok: false, error: 'foreign denied' })
+    expect(f.rejected).toEqual([])
+    f.recv({ commandId: 'correct', requestId: null, ok: false, error: 'expected rejection' })
+    expect(f.rejected).toEqual(['correct:expected rejection'])
+    expect(f.probe.pendingCommands.has('other')).toBe(true)
+    expect(f.delivered).toEqual(['correct'])
+  })
+})
