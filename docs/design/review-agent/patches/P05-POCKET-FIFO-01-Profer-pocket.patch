+  private resolveCommandResult(msg: CommandResultMessage): CommandResultMessage | null {
+    // Prefer transport commandId. The business requestId (permission/AskUser)
+    // is not a safe fallback when an explicit commandId is present but unknown.
+    const id = typeof msg.commandId === 'string' && msg.commandId.length > 0
+      ? msg.commandId
+      : typeof msg.requestId === 'string' && msg.requestId.length > 0 ? msg.requestId : null
+    if (id && this.completedCommands.has(id)) return null
+    // A legacy server may respond to resume_agent_events as a command.
+    if (id && id === this.resumeCommandId) {
+      this.resumeCommandId = null
+      return null
+    }
+    if (id) {
+      const pending = this.pendingCommands.get(id)
+      if (!pending) return null // Never consume a different pending command.
+      this.pendingCommands.delete(id)
+      this.completedCommands.add(id)
+      if (msg.ok) pending.resolve(msg.data)
+      else pending.reject(new Error(msg.conflict?.code ? `${msg.conflict.code}: ${msg.error || '指令失败'}` : (msg.error || '指令失败')))
+      return { ...msg, commandId: id }
+    }
+    // Legacy ID-less replies are ambiguous with concurrent requests.
+    // Only allow FIFO compatibility with exactly one outstanding command.
+    if (this.pendingCommands.size !== 1) return null
+    const fallback = this.pendingCommands.entries().next().value as [string, { resolve: (r: unknown) => void; reject: (e: Error) => void }] | undefined
+    if (!fallback) return null
+    const [fid, pending] = fallback
+    this.pendingCommands.delete(fid)
+    this.completedCommands.add(fid)
+    if (msg.ok) pending.resolve(msg.data)
+    else pending.reject(new Error(msg.conflict?.code ? `${msg.conflict.code}: ${msg.error || '指令失败'}` : (msg.error || '指令失败')))
+    // Also normalize the Remote Store callback to the settled command.
+    return { ...msg, commandId: fid, requestId: null }
   }
 
